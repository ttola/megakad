---
interface Props {
  formHref: string;
}

const { formHref } = Astro.props;
const now = new Date();
const year = now.getFullYear();
const quarter = Math.floor(now.getMonth() / 3) + 1;
---

<section class="mf-hero" aria-labelledby="hero-title">
  <div class="wrap">
    <a
      class="mf-stamp"
      href={formHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open the consulting briefing form"
    >
      Now<span class="big">Booking</span><span class="it"><span data-current-year>{year}</span> — Q<span data-current-quarter>{quarter}</span></span>
    </a>
    <div class="eyebrow"><span class="pulse"></span>Independent consulting · Currently shipping</div>
    <h1 id="hero-title">
      We build<br />
      <span class="l2">the apps,</span>
      <span class="l3">the <em>pipelines,</em></span>
      <span class="l3 l4">the <em>teams.</em></span>
    </h1>
    <div class="lede">
      <p class="sig">
        Megakad is an independent consulting practice — retained by banks, defence
        programmes, fintechs and retailers to lead the hard parts of building software.
      </p>
      <div class="meta">
        <strong>Established 2014</strong>
        Mobile-first technical lead. React Native, Expo, micro-frontends, and the CI/CD
        plumbing that lets a team move quickly without breaking the audit trail.
      </div>
    </div>
    <div class="cta-row">
      <a class="mf-btn" href="#portfolio">View consulting work ↓</a>
      <a class="mf-btn alt" href="#contact">Send a brief ↗</a>
    </div>
  </div>
</section>
