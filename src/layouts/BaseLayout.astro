---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Megakad — independent consulting",
  description = "Megakad is an independent consulting practice for mobile, web, and platform engineering teams that have to ship.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F1C232" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23f1c232'/%3E%3Ctext x='8' y='43' font-family='Arial,sans-serif' font-size='28' font-weight='900' fill='%230a0a0a'%3EM%3C/text%3E%3Ccircle cx='50' cy='45' r='5' fill='%23e6377a'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400;12..96,75..100,500;12..96,75..100,700;12..96,75..100,800&family=JetBrains+Mono:wght@400;500;700&display=block"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/global.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const now = new Date();
        const year = String(now.getFullYear());
        const quarter = String(Math.floor(now.getMonth() / 3) + 1);

        document.querySelectorAll("[data-current-year]").forEach((node) => {
          node.textContent = year;
        });
        document.querySelectorAll("[data-current-quarter]").forEach((node) => {
          node.textContent = quarter;
        });
      })();
    </script>
  </body>
</html>
