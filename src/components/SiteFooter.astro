---
import type { Identity } from "../data/megakad";

interface Props {
  identity: Identity;
}

const { identity } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mf-foot">
  <div class="wrap">
    <div class="wm">{identity.company.toUpperCase()} CONSULTING LTD · {year}</div>
    <div>Now booking 2026 Q2</div>
  </div>
</footer>
